# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — dashboard.stripe.com/test/apikeys (use test mode keys until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or from the webhook endpoint you create in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute redirect URLs for Stripe Checkout/Connect
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — resend.com/api-keys
RESEND_API_KEY=re_...
# Shared secret checked against the x-webhook-secret header on every call
# from the Supabase Database Webhook. Generate with `openssl rand -hex 32`
# and paste the same value into that webhook's custom header.
SUPABASE_DB_WEBHOOK_SECRET=
